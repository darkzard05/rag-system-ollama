# ============================================================================
# RAG System Configuration File
# ============================================================================
# 이 파일을 .env로 복사하고 아래 값들을 환경에 맞게 설정하세요.
# 모든 변수는 선택 사항이며, 미설정 시 config.yml 또는 코드 기본값이 사용됩니다.
# ============================================================================

# ============================================================================
# 1. 모델 설정 (Models)
# ============================================================================

# Ollama 서버 주소
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 기본 LLM 모델
DEFAULT_OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

# LLM 생성 파라미터
OLLAMA_NUM_PREDICT=4096
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=4096
OLLAMA_TOP_P=0.8
OLLAMA_KEEP_ALIVE=30m

# 기본 임베딩 모델
DEFAULT_EMBEDDING_MODEL=nomic-embed-text-v2-moe

# 임베딩 배치 사이즈 (정수 또는 문자열, 예: auto)
EMBEDDING_BATCH_SIZE=16

# 임베딩 디바이스 (auto | cpu | cuda)
EMBEDDING_DEVICE=auto

# 동시 추론/리소스 풀 제한
MAX_CONCURRENT_INFERENCE=1
MAX_CACHED_MODELS=5
MAX_RESOURCE_POOL_SIZE=10
MAX_RESOURCE_POOL_SIZE_BYTES=2147483648

# ============================================================================
# 2. 캐시 설정 (Cache & Security)
# ============================================================================

# 벡터 캐시 활성화
ENABLE_VECTOR_CACHE=true

# 캐시 보안 수준 및 HMAC 시크릿 (빈 값이면 config.yml 사용)
CACHE_SECURITY_LEVEL=medium
CACHE_HMAC_SECRET=

# 캐시 파일 권한 검사 활성화
CACHE_CHECK_PERMISSIONS=true

# ============================================================================
# 3. 평가 설정 (Evaluation)
# ============================================================================

# 평가 판정 모델 (빈 값이면 DEFAULT_OLLAMA_MODEL 사용)
EVAL_JUDGE_MODEL=

# ============================================================================
# 4. API & 인증 설정 (API & Auth)
# ============================================================================

# 관리자 비밀번호. 미설정 시 무작위 비밀번호가 생성되어 부트 시 stderr로 1회 출력됩니다.
TEST_ADMIN_PASSWORD=

# 관리자 API 키. 미설정 시 24시간 유효한 무작위 키가 생성되어 부트 시 stderr로 1회 출력됩니다.
TEST_API_KEY=

# JWT 서명 키. 미설정 시 무작위 키가 생성되어 AUTH_SECRET_FILE에 영구 저장됩니다.
JWT_SECRET_KEY=

# 인증 상태(사용자/세션/API 키/deny-list) 영구 저장 파일 경로. 기본: .model_cache/auth_state.json
AUTH_STATE_FILE=.model_cache/auth_state.json

# JWT 시크릿 영구 저장 파일 경로 (0o600 권한). 기본: .model_cache/.jwt_secret
AUTH_SECRET_FILE=.model_cache/.jwt_secret

# ============================================================================
# 5. CI/테스트 설정 (CI & Testing)
# ============================================================================

# "true"면 CI/유닛 테스트 모드 활성화 (실제 모델 없이 FakeEmbeddings/가짜 LLM 사용)
IS_CI_TEST=false
IS_UNIT_TEST=false

# GitHub Actions에서 자동 설정됨 (로컬에서는 건드리지 마세요. 코드가 CI 경로를 감지할 때 사용)
GITHUB_ACTIONS=false
